# udev rules for Apple iOS / iPadOS devices (Normal, Recovery, DFU, Composite USB modes)
# Ensures non-root access on Fedora, Ubuntu, Debian, Arch, and openSUSE.

SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="12a8", MODE="0666", TAG+="uaccess", TAG+="systemd", ENV{USBMUX_SUPPORTED}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="12aa", MODE="0666", TAG+="uaccess", TAG+="systemd", ENV{USBMUX_SUPPORTED}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="12ab", MODE="0666", TAG+="uaccess", TAG+="systemd", ENV{USBMUX_SUPPORTED}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="12a9", MODE="0666", TAG+="uaccess", TAG+="systemd", ENV{USBMUX_SUPPORTED}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="12af", MODE="0666", TAG+="uaccess", TAG+="systemd", ENV{USBMUX_SUPPORTED}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1281", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1227", MODE="0666", TAG+="uaccess"
